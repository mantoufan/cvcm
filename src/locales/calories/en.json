  "hub": {
    "title": "Calories in Food: Calorie Chart for {n} Common Foods per 100 g",
    "description": "How many calories are in a banana, a cup of rice or an egg? Calories, protein, fat and carbs per 100 g and per serving for {n} common foods, from USDA FoodData Central.",
    "h1": "Food calorie chart",
    "lede": "Calories, protein, fat and carbohydrate per 100 g for {n} common foods: fruit, vegetables, rice, noodles and bread, meat, fish, eggs and dairy, tofu and beans, nuts, oils, drinks and sweets. Search the table or sort any column, then open a food for its full nutrition facts, the calories in a typical serving and a gram calculator.",
    "about": [
      "Every number comes from USDA FoodData Central. Where FoodData Central has a Foundation Foods record (newer laboratory analyses) the page uses it; otherwise it uses the SR Legacy record. Each food page names the record, links to it and shows when the data were taken.",
      "Raw and cooked foods are listed separately because cooking adds or removes water: 100 g of cooked rice weighs mostly water, so it has far fewer calories than 100 g of uncooked rice. Serving weights are USDA household measures such as one medium banana or one cup of cooked rice."
    ],
    "faq": [
      {
        "q": "Where do these calorie numbers come from?",
        "a": "From USDA FoodData Central, the United States Department of Agriculture's food composition database. Foundation Foods records are used where they exist and SR Legacy records otherwise. The data are in the public domain (CC0 1.0)."
      },
      {
        "q": "Why does cooked rice have fewer calories per 100 g than uncooked rice?",
        "a": "Rice absorbs water as it cooks, so 100 g of cooked rice contains less rice and more water than 100 g of dry rice. The calories in the whole pot do not change much; they are spread over a heavier weight. The same applies to pasta, noodles, oats and beans."
      },
      {
        "q": "How is the serving size chosen?",
        "a": "Each food uses one household measure from USDA's portion data, such as one medium apple, one large egg or one cup of cooked rice, with its weight in grams. For any other amount, type the weight into the calculator on the food's page."
      }
    ]
  },

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cvcm",
  "compatibility_date": "2026-09-06",
  // Built by scripts/build-worker.mjs (`npm run build`), which bundles it as UTF-8; deploy with --no-bundle.
  "main": "dist/_worker.js",
  "no_bundle": true,
  // dist/ also holds the client chunks; only the single built script is the Worker.
  "find_additional_modules": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Like cvcm.pages.dev before it: a direct origin for comparing against cv.cm.
  "workers_dev": true,
  "preview_urls": false,
  // DNS for both hosts still points at the old Pages project; these routes put the Worker in front of it.
  "routes": [
    { "pattern": "cv.cm/*", "zone_name": "cv.cm" },
    { "pattern": "www.cv.cm/*", "zone_name": "cv.cm" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cvcm",
      "database_id": "1a809cf5-bb42-4f8d-b2c6-6cd7430226c5"
    }
  ],
  "vars": {
    "S3_HOST": "s3.cv.cm",
    "S3_BUCKET": "files",
    "S3_REGION": "us-east-1"
  }
}

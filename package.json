{
  "name": "cvcm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "cv.cm — cloud clipboard and browser tools",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/write-sitemap.mjs && vite",
    "build": "node scripts/write-sitemap.mjs && vite build && node --max-old-space-size=8192 scripts/prerender.mjs && node scripts/build-worker.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "kb:sync": "node scripts/kb-sync.mjs",
    "ref:sync": "node scripts/ref-sync.mjs",
    "slang:sync": "node scripts/slang-sync.mjs",
    "search:demand": "node scripts/search-tool.mjs demand",
    "search:notify": "node scripts/search-tool.mjs notify",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "happy-dom": "^20.14.5",
    "sharp": "^0.35.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@magenta/music": "1.23.1",
    "chess.js": "1.4.0",
    "mp4-muxer": "5.2.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  }
}
